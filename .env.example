# Copy this file to `.env` and fill in your own values.
# NEVER commit your real `.env` or your `.pem` private key — both are gitignored.
#
# Demo credentials are SEPARATE from production. Create a demo account and an
# API key at https://demo.kalshi.co, and production keys at https://kalshi.com.

# Your Kalshi API key id (looks like a UUID).
KALSHI_API_KEY=your-api-key-id-here

# Your RSA private key. Provide ONE of these:
#   KALSHI_PEM_PATH      — path to the .pem file Kalshi gave you (default: ./kalshi.pem)
#   KALSHI_PEM_CONTENTS  — the PEM inline, with \n for newlines (handy in containers)
KALSHI_PEM_PATH=./kalshi.pem
# KALSHI_PEM_CONTENTS="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Which environment to talk to:
#   demo — fake money, safe to experiment (default)
#   prod — REAL money
KALSHI_ENV=demo
